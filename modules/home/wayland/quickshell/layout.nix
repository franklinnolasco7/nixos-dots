# Shared bar geometry for quickshell widgets. Values mirror the waybar
# spacing rules the bar replicates; tune here and every consumer follows.
{
  # Standard modules' side padding (os-logo, wifi, battery): style.nix
  # "padding: 0 6px".
  modulePadding = 6;
  # Wide modules' side padding (clock, focused-app): "padding: 0 8px".
  wideModulePadding = 8;
}
