{
  "$schema": "./config.schema.json",
  "positionX": "right",
  "positionY": "top",
  "cssPriority": "user",
  "control-center-width": 450,
  "control-center-height": 800,
  "control-center-margin-top": 8,
  "control-center-margin-bottom": 8,
  "control-center-margin-right": 8,
  "control-center-margin-left": 0,
  "fit-to-screen": true,

  "notification-window-width": 400,
  "notification-icon-size": 48,
  "notification-body-image-height": 500,
  "notification-body-image-width": 500,
  "notification-inline-replies": true,
  "notification-2fa-action": true,

  "timeout": 5,
  "timeout-low": 0,
  "timeout-critical": 0,

  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,

  "scripts": {
    "default-sound": {
      "exec": "$HOME/.config/swaync/scripts/default-sound.sh",
      "urgency": "Low|Normal"
    },
    "critical-sound": {
      "exec": "$HOME/.config/swaync/scripts/critical-sound.sh",
      "urgency": "Critical"
    }
  },

  "widgets": [
    "mpris",
    "volume",
    "backlight",
    "dnd",
    "notifications",
    "buttons-grid"
  ],

  "widget-config": {
    "backlight": {
      "device": "amdgpu_bl1",
      "label": "󰃠",
      "slider": true,
      "min": 5,
      "max": 100
    },
    "volume": {
      "label": "󰕾",
      "show-per-app": true,
      "slider": true
    },

    "dnd": {
      "text": "Do Not Disturb"
    },

    "mpris": {
      "image-size": 110,
      "image-radius": 12,
      "blur": true,
      "autohide": false,
      "blacklist": ["chromium", "firefox"]
    },

    "buttons-grid": {
      "actions": [
        {
          "label": "",
          "command": "swaync-client -cp && systemctl poweroff"
        },
        {
          "label": "",
          "command": "swaync-client -cp && systemctl reboot"
        },
        {
          "label": "󰤄",
          "command": "swaync-client -cp && systemctl suspend"
        },
        {
          "label": "",
          "command": "hyprlock"
        },
        {
          "label": "󰍃",
          "command": "swaync-client -cp && hyprctl dispatch exit"
        },
        {
          "label": "󰌐",
          "type": "toggle",
          "command": "$HOME/.local/bin/toggle-laptop-kb.sh apply \"$SWAYNC_TOGGLE_STATE\"",
          "update-command": "$HOME/.local/bin/toggle-laptop-kb.sh status"
        },
        {
          "label": "󰍾",
          "type": "toggle",
          "command": "$HOME/.local/bin/toggle-laptop-tp.sh apply \"$SWAYNC_TOGGLE_STATE\"",
          "update-command": "$HOME/.local/bin/toggle-laptop-tp.sh status"
        },
        {
          "label": "󰀝",
          "type": "toggle",
          "command": "$HOME/.local/bin/airplane-mode.sh apply \"$SWAYNC_TOGGLE_STATE\"",
          "update-command": "$HOME/.local/bin/airplane-mode.sh status"
        },
        {
          "label": "󰖂",
          "type": "toggle",
          "command": "$HOME/.local/bin/vpn-toggle.sh apply \"$SWAYNC_TOGGLE_STATE\"",
          "update-command": "$HOME/.local/bin/vpn-toggle.sh status"
        },
        {
          "label": "󱇣",
          "command": "$HOME/.local/bin/annotate-last-screenshot.sh"
        }
      ]
    }
  }
}
